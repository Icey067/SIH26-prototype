# Environment Configuration
PROJECT_NAME="Samanvay-AI Indian Railways Block Planning Engine"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration (Defaults to SQLite for local development)
# For Supabase / PostgreSQL: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DB]
DATABASE_URL="sqlite:///./samanvay.db"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Indian Railways Division Default
DEFAULT_DIVISION="Prayagraj (NCR)"
DEFAULT_CORRIDOR="Ghaziabad - Kanpur Main Line"


